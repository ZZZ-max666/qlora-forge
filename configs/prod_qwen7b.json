{
  "model": "Qwen/Qwen2.5-7B-Instruct",
  "model_profile": "qwen2.5-7b",
  "method": "qlora",
  "quant": {
    "load_in_4bit": true,
    "bnb_4bit_quant_type": "nf4",
    "bnb_4bit_use_double_quant": true,
    "bnb_4bit_compute_dtype": "bfloat16"
  },
  "lora": {
    "r": 16,
    "alpha": 32,
    "dropout": 0.05,
    "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"]
  },
  "train": {
    "epochs": 3,
    "batch_size": 1,
    "grad_accum": 16,
    "lr": 0.0001,
    "lr_scheduler": "cosine",
    "warmup_ratio": 0.03,
    "weight_decay": 0.0,
    "seq_len": 2048,
    "gradient_checkpointing": true,
    "logging_steps": 5,
    "seed": 42
  },
  "data": {
    "train": "outputs/dataset/train.jsonl",
    "val": "outputs/dataset/val.jsonl"
  },
  "output_dir": "outputs/checkpoints/prod_qwen7b",
  "_note": "生产配置：7B QLoRA，NF4 双量化，注意力+FFN 全线性层目标模块，有效 batch=16。估算显存见 README 表格（12GB 级显卡可跑通，建议 16GB+）。"
}
